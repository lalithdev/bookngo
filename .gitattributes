# Normalize text files and use LF line endings
* text=auto eol=lf

# Java
*.java text

# Maven / XML
*.xml text

# YAML
*.yml text
*.yaml text

# JSON
*.json text

# Markdown
*.md text

# JavaScript
*.js text

# CSS
*.css text

# HTML
*.html text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
